# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.

# PostgreSQL connection string
# For Supabase: use the POOLER (Transaction) URL for DATABASE_URL and the DIRECT URL for DIRECT_URL
# Supabase pooler URL (port 5432 or 6543): used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require"
# Supabase direct URL (port 5432, direct connection): used by Prisma CLI (db push, migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# NextAuth secret — generate with: openssl rand -base64 32
# NextAuth v5 uses AUTH_SECRET; v4 used NEXTAUTH_SECRET. Both are accepted.
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# App base URL
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
